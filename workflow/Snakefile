"""
Pipeline to process RiboLace data
Based on Immagina ALL-IN-ONE RiboLace Gel Free documentation (V15.5)
"""

import csv
import os
import yaml

RAW_DATA_DIR = config["raw_data_dir"]
RESULTS_DIR = config["results_dir"]
SAMPLES_TSV = config["samples"]
SCRIPTS_DIR = os.path.join(workflow.basedir, "scripts")
with open(config["tools"]) as f:
	TOOLS = yaml.safe_load(f)

# Pipeline version (bump VERSION file on each release)
PIPELINE_HOME = os.path.dirname(workflow.basedir)
with open(os.path.join(PIPELINE_HOME, "VERSION")) as f:
	PIPELINE_VERSION = f.read().strip()
print(f"Pipeline version: {PIPELINE_VERSION}")

onstart:
	os.makedirs(RESULTS_DIR, exist_ok=True)
	with open(os.path.join(RESULTS_DIR, "pipeline_version.txt"), "w") as f:
		f.write(f"{PIPELINE_VERSION}\n")


def load_samples(samples_tsv):
	"""Load single-end sample sheet with columns: Sample, Fastq."""
	if not os.path.exists(samples_tsv):
		raise ValueError(f"Sample metadata file not found: {samples_tsv}")

	with open(samples_tsv, newline="") as handle:
		reader = csv.DictReader(handle, delimiter="\t")
		required_cols = {"Sample", "Fastq"}
		if reader.fieldnames is None:
			raise ValueError(f"Sample metadata TSV appears empty: {samples_tsv}")

		missing = required_cols - set(reader.fieldnames)
		if missing:
			raise ValueError(
				f"Sample metadata TSV is missing required columns: {sorted(missing)}"
			)

		records = list(reader)

	if not records:
		raise ValueError("Sample metadata TSV has no samples")

	sample_map = {}
	for row in records:
		sample = row["Sample"].strip()
		fastq = row["Fastq"].strip()
		if not sample or not fastq:
			raise ValueError("Each sample row must include non-empty 'Sample' and 'Fastq' values")
		if sample in sample_map:
			raise ValueError(f"Duplicate sample name in sample sheet: {sample}")
		sample_map[sample] = fastq
	return sample_map


SAMPLES = load_samples(SAMPLES_TSV)
SAMPLE_NAMES = list(SAMPLES.keys())


localrules: multiqc


rule all:
	input:
		expand(f"{RESULTS_DIR}/qc/{{sample}}_fastqc.html", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/qc/{{sample}}_fastqc.zip", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/trim/{{sample}}.trim.fastq.gz", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/trim/{{sample}}.umi.fastq.gz", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/trim/{{sample}}.trim2.fastq.gz", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/filter_contaminants/{{sample}}.clean.fastq.gz", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/star/{{sample}}.Aligned.sortedByCoord.out.bam", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/star/{{sample}}.dedup.bam", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/star/{{sample}}.dedup.transcriptome.bam", sample=SAMPLE_NAMES),
		f"{RESULTS_DIR}/qc/multiqc_report.html",
		expand(f"{RESULTS_DIR}/ribowaltz/{{sample}}.ribowaltz.html", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/ribowaltz/{{sample}}.cds_coverage.tsv", sample=SAMPLE_NAMES),

# QC

rule fastqc:
	input:
		lambda wc: f"{RAW_DATA_DIR}/{SAMPLES[wc.sample]}"
	output:
		html = f"{RESULTS_DIR}/qc/{{sample}}_fastqc.html",
		zip = f"{RESULTS_DIR}/qc/{{sample}}_fastqc.zip"
	params:
		outdir=f"{RESULTS_DIR}/qc"
	envmodules:
		TOOLS["fastqc"]
	shell:
		"""
		# Get the input filename without path
		infile=$(basename {input})
		inbase="${{infile%.*}}"  # Remove .gz
		inbase="${{inbase%.*}}"  # Remove .fastq
		
		# Run fastqc
		fastqc --threads $SLURM_CPUS_PER_TASK -o {params.outdir} {input}
		
		# Rename outputs to match expected naming
		mv {params.outdir}/${{inbase}}_fastqc.html {output.html}
		mv {params.outdir}/${{inbase}}_fastqc.zip {output.zip}
		"""
        

# ---------------------------------------------------------------------------
# Step E2: UMI extraction/trimming
# ---------------------------------------------------------------------------

# Cutadapt to remove linker MC+ and following sequence from 3' end
# Only reads longer than X+9 nt are retained (X is length of the RPF
# (usually X=20 for ribosome profiling analysis), and 9 is the sum of
# the lengths of the 5' and 3' UMIs)
# -a Removal of the LACE-seq 3' linker and any sequence that may follow
# Reads in which no adapter is found are discarded
#
# cutadapt --cores N --minimum-length X+9 -a TCTCCTTGCATAATCACCAACC \
#   --discard-untrimmed -o trim.fastq input.fastq

rule remove_linker:
	input:
		lambda wc: f"{RAW_DATA_DIR}/{SAMPLES[wc.sample]}"
	output:
		f"{RESULTS_DIR}/trim/{{sample}}.trim.fastq.gz"
	envmodules:
		TOOLS["cutadapt"]
	shell:
		"""
		cutadapt --cores $SLURM_CPUS_PER_TASK --minimum-length 29 \
			-a TCTCCTTGCATAATCACCAACC --discard-untrimmed \
			-o {output} {input}
		"""


# UMI-tools extract to move UMI sequence to read name
# Extract the first 4 (5'UMI) and the last 4 bases (3'UMI) of each read
#
# umi_tools extract -I trim.fastq \
#   --bc-pattern='^(?P<umi_1>.{4}).+(?P<umi_2>.{4})$' \
#   --extract-method=regex -S extract.fastq --log=<umi_extract.log>

rule extract_umi:
	input:
		f"{RESULTS_DIR}/trim/{{sample}}.trim.fastq.gz"
	output:
		f"{RESULTS_DIR}/trim/{{sample}}.umi.fastq.gz"
	log:
		f"{RESULTS_DIR}/trim/{{sample}}.umi_extract.log"
	envmodules:
		TOOLS["umi_tools"]
	shell:
		"""
		umi_tools extract -I {input} \
			--bc-pattern='^(?P<umi_1>.{{4}}).+(?P<umi_2>.{{4}})$' \
			--extract-method=regex \
			-S {output} \
			--log={log}
		"""


# Cutadapt to remove preceding T
#
# cutadapt --cores N -g ^T --discard-untrimmed -o trim2.fastq extract.fastq

rule remove_t:
	input:
		f"{RESULTS_DIR}/trim/{{sample}}.umi.fastq.gz"
	output:
		f"{RESULTS_DIR}/trim/{{sample}}.trim2.fastq.gz"
	envmodules:
		TOOLS["cutadapt"]
	shell:
		"""
		cutadapt --cores $SLURM_CPUS_PER_TASK -g ^T \
			--discard-untrimmed -o {output} {input}
		"""


# ---------------------------------------------------------------------------
# Step E3: Filtering rRNA, tRNA and snRNA
# ---------------------------------------------------------------------------

# To build bowtie2 indexes, fasta files of contaminating sequences
# (tRNAs, rRNAs and snRNAs or ncRNAs) are necessary (https://rnacentral.org/)
#
# bowtie2-build --threads N - f <reference.fasta.file> <given_index_name>

rule create_contaminant_index:
	input:
		rrna=config["rrna_fasta"],
		trna=config["trna_fasta"],
		snrna=config["snrna_fasta"],
	output:
		rrna_1=f"{RESULTS_DIR}/filter_contaminants/index/rrna.1.bt2",
		rrna_2=f"{RESULTS_DIR}/filter_contaminants/index/rrna.2.bt2",
		rrna_3=f"{RESULTS_DIR}/filter_contaminants/index/rrna.3.bt2",
		rrna_4=f"{RESULTS_DIR}/filter_contaminants/index/rrna.4.bt2",
		rrna_rev1=f"{RESULTS_DIR}/filter_contaminants/index/rrna.rev.1.bt2",
		rrna_rev2=f"{RESULTS_DIR}/filter_contaminants/index/rrna.rev.2.bt2",
		trna_1=f"{RESULTS_DIR}/filter_contaminants/index/trna.1.bt2",
		trna_2=f"{RESULTS_DIR}/filter_contaminants/index/trna.2.bt2",
		trna_3=f"{RESULTS_DIR}/filter_contaminants/index/trna.3.bt2",
		trna_4=f"{RESULTS_DIR}/filter_contaminants/index/trna.4.bt2",
		trna_rev1=f"{RESULTS_DIR}/filter_contaminants/index/trna.rev.1.bt2",
		trna_rev2=f"{RESULTS_DIR}/filter_contaminants/index/trna.rev.2.bt2",
		snrna_1=f"{RESULTS_DIR}/filter_contaminants/index/snrna.1.bt2",
		snrna_2=f"{RESULTS_DIR}/filter_contaminants/index/snrna.2.bt2",
		snrna_3=f"{RESULTS_DIR}/filter_contaminants/index/snrna.3.bt2",
		snrna_4=f"{RESULTS_DIR}/filter_contaminants/index/snrna.4.bt2",
		snrna_rev1=f"{RESULTS_DIR}/filter_contaminants/index/snrna.rev.1.bt2",
		snrna_rev2=f"{RESULTS_DIR}/filter_contaminants/index/snrna.rev.2.bt2",
	params:
		rrna_prefix=f"{RESULTS_DIR}/filter_contaminants/index/rrna",
		trna_prefix=f"{RESULTS_DIR}/filter_contaminants/index/trna",
		snrna_prefix=f"{RESULTS_DIR}/filter_contaminants/index/snrna"
	envmodules:
		TOOLS["bowtie2"]
	shell:
		"""
		bowtie2-build --threads $SLURM_CPUS_PER_TASK -f {input.rrna} {params.rrna_prefix}
		bowtie2-build --threads $SLURM_CPUS_PER_TASK -f {input.trna} {params.trna_prefix}
		bowtie2-build --threads $SLURM_CPUS_PER_TASK -f {input.snrna} {params.snrna_prefix}
		"""


# Remove and quantify contaminants (rRNA, tRNA, snRNA) by aligning trimmed
# reads against contaminant sequences with Bowtie2
# Allows 1 mismatch (-N)
# --no-1mm-upfront prevents Bowtie2 from searching for 1-mismatch
# end-to-end alignments
#
# bowtie2 --threads N -N 1 --no-1mm-upfront -q <trimmed.fastq.gz> \
#   --un=<norRNA.fastq.gz> -x <rRNA_bowtie_index>
# bowtie2 --threads N -N 1 --no-1mm-upfront -q <norRNA.fastq.gz> \
#   --un=<norRNA_notRNA.fastq.gz> -x <tRNA_bowtie_index>
# bowtie2 --threads N -N 1 --no-1mm-upfront -q <norRNA_notRNA.fastq.gz> \
#   --un=<norRNA_notRNA_nonsnRNA.fastq.gz> -x <snRNA_bowtie_index>

rule remove_contaminants:
	input:
		fastq=f"{RESULTS_DIR}/trim/{{sample}}.trim2.fastq.gz",
		rrna_idx=f"{RESULTS_DIR}/filter_contaminants/index/rrna.1.bt2",
		trna_idx=f"{RESULTS_DIR}/filter_contaminants/index/trna.1.bt2",
		snrna_idx=f"{RESULTS_DIR}/filter_contaminants/index/snrna.1.bt2",
	output:
		f"{RESULTS_DIR}/filter_contaminants/{{sample}}.clean.fastq.gz"
	log:
		rrna=f"{RESULTS_DIR}/filter_contaminants/{{sample}}.rrna_mapping.log",
		trna=f"{RESULTS_DIR}/filter_contaminants/{{sample}}.trna_mapping.log",
		snrna=f"{RESULTS_DIR}/filter_contaminants/{{sample}}.snrna_mapping.log"
	params:
		rrna_prefix=f"{RESULTS_DIR}/filter_contaminants/index/rrna",
		trna_prefix=f"{RESULTS_DIR}/filter_contaminants/index/trna",
		snrna_prefix=f"{RESULTS_DIR}/filter_contaminants/index/snrna",
		mismatches=1,
		rrna_un=f"{RESULTS_DIR}/filter_contaminants/{{sample}}.norRNA.fastq.gz",
		trna_un=f"{RESULTS_DIR}/filter_contaminants/{{sample}}.norRNA_notRNA.fastq.gz"
	envmodules:
		TOOLS["bowtie2"]
	shell:
		"""
		bowtie2 --threads $SLURM_CPUS_PER_TASK -N {params.mismatches} --no-1mm-upfront -q \
			-U {input.fastq} --un-gz {params.rrna_un} -x {params.rrna_prefix} \
			-S /dev/null 2> {log.rrna}

		bowtie2 --threads $SLURM_CPUS_PER_TASK -N {params.mismatches} --no-1mm-upfront -q \
			-U {params.rrna_un} --un-gz {params.trna_un} -x {params.trna_prefix} \
			-S /dev/null 2> {log.trna}

		bowtie2 --threads $SLURM_CPUS_PER_TASK -N {params.mismatches} --no-1mm-upfront -q \
			-U {params.trna_un} --un-gz {output} -x {params.snrna_prefix} \
			-S /dev/null 2> {log.snrna}
		"""


# ---------------------------------------------------------------------------
# Step E4: STAR alignment to genome
# ---------------------------------------------------------------------------

# calculated size is 14 for hg38
#
# STAR --runMode genomeGenerate --runThreadN N --genomeDir <location_for_index> \
#   --genomeFastaFiles <location_of_fasta_file> \
#   --genomeSAindexNbases <calculated size> --sjdbGTFfile <location_of_gtf_file>

rule create_star_index:
	input:
		fasta=config["reference_fasta"],
		gtf=config["reference_gtf"],
	output:
		f"{RESULTS_DIR}/star/index/SA"
	params:
		genome_dir=f"{RESULTS_DIR}/star/index",
	envmodules:
		TOOLS["star"]
	shell:
		"""
		STAR --runMode genomeGenerate --runThreadN $SLURM_CPUS_PER_TASK \
			--genomeDir {params.genome_dir} \
			--genomeFastaFiles {input.fasta} \
			--genomeSAindexNbases 14 \
			--sjdbGTFfile {input.gtf}
		"""


rule star_alignment:
	input:
		fastq=f"{RESULTS_DIR}/filter_contaminants/{{sample}}.clean.fastq.gz",
		idx=f"{RESULTS_DIR}/star/index/SA",
	output:
		genome_bam=f"{RESULTS_DIR}/star/{{sample}}.Aligned.sortedByCoord.out.bam",
		txome_bam=f"{RESULTS_DIR}/star/{{sample}}.Aligned.toTranscriptome.out.bam"
	params:
		genome_dir=f"{RESULTS_DIR}/star/index",
		prefix=lambda wc: f"{RESULTS_DIR}/star/{wc.sample}."
	envmodules:
		TOOLS["star"],
		TOOLS["samtools"]
	shell:
		"""
		STAR --runThreadN $SLURM_CPUS_PER_TASK \
			--genomeDir {params.genome_dir} \
			--readFilesIn {input.fastq} \
			--readFilesCommand zcat \
			--outSAMtype BAM SortedByCoordinate \
			--quantMode TranscriptomeSAM \
			--outFileNamePrefix {params.prefix}

		samtools index {output.genome_bam}
		"""

# Deduplicate reads using UMI and mapping coordinates

rule dedup_umi:
	input:
		bam = f"{RESULTS_DIR}/star/{{sample}}.Aligned.sortedByCoord.out.bam",
	output:	
		bam = f"{RESULTS_DIR}/star/{{sample}}.dedup.bam",
		stats = f"{RESULTS_DIR}/star/{{sample}}.dedup.stats_per_umi.tsv"
	params: 
		stats = f"{RESULTS_DIR}/star/{{sample}}.dedup.stats"
	envmodules:
		TOOLS["umi_tools"]
	shell:
		"""
		umi_tools dedup -I {input.bam} --output-stats={params.stats} -S {output.bam}
		"""


# Filter transcriptome BAM to retain only reads that survived UMI deduplication.

rule filter_transcriptome_bam:
	input:
		dedup_bam = f"{RESULTS_DIR}/star/{{sample}}.dedup.bam",
		txome_bam = f"{RESULTS_DIR}/star/{{sample}}.Aligned.toTranscriptome.out.bam"
	output:
		f"{RESULTS_DIR}/star/{{sample}}.dedup.transcriptome.bam"
	envmodules:
		TOOLS["samtools"]
	shell:
		"""
		# Extract read names surviving deduplication
		samtools view -F 4 {input.dedup_bam} | cut -f1 | sort -u > {output}.names.txt

		# Filter transcriptome alignments by read-name allowlist from deduplicated BAM
		samtools view -h -N {output}.names.txt {input.txome_bam} \
			| samtools sort -@ $SLURM_CPUS_PER_TASK -o {output}
		samtools index {output}

		rm -f {output}.names.txt
		"""	

# ---------------------------------------------------------------------------
# MultiQC: Aggregate QC results
# ---------------------------------------------------------------------------

rule multiqc:
	input:
		expand(f"{RESULTS_DIR}/qc/{{sample}}_fastqc.html", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/trim/{{sample}}.trim2.fastq.gz", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/filter_contaminants/{{sample}}.clean.fastq.gz", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/star/{{sample}}.Aligned.sortedByCoord.out.bam", sample=SAMPLE_NAMES),
		expand(f"{RESULTS_DIR}/star/{{sample}}.dedup.stats_per_umi.tsv", sample=SAMPLE_NAMES),
	output:
		f"{RESULTS_DIR}/qc/multiqc_report.html"
	params:
		outdir=f"{RESULTS_DIR}/qc"
	envmodules:
		TOOLS["multiqc"]
	shell:
		"""
		multiqc --force {RESULTS_DIR} -o {params.outdir} -n multiqc_report.html
		"""


# ---------------------------------------------------------------------------
# Step E5: RiboWaltz pipeline
# ---------------------------------------------------------------------------

# Ribosomal footprint analysis
# R package that integrates QC of ribosome profiling data and P-site
# identification for improved interpretation of positional information
# Use transcriptome BAM file and GTF annotation file to run riboWaltz
# (https://github.com/LabTranslationalArchitectomics/riboWaltz)

rule ribowaltz:
	input:
		bam = f"{RESULTS_DIR}/star/{{sample}}.dedup.transcriptome.bam",
	output:
		coverage = f"{RESULTS_DIR}/ribowaltz/{{sample}}.cds_coverage.tsv",
		html = f"{RESULTS_DIR}/ribowaltz/{{sample}}.ribowaltz.html"
	params:
		gtf=config["reference_gtf"],
		transcript_fasta=config["transcript_fasta"],
		ribowaltz_rmd=f"{SCRIPTS_DIR}/ribowaltz.Rmd",
		linked_bam=f"{RESULTS_DIR}/ribowaltz/{{sample}}.dedup.transcriptome.bam",
	envmodules:
		TOOLS["r"]
	shell:
		"""
		mkdir -p {RESULTS_DIR}/ribowaltz
		ln -sfn {input.bam} {params.linked_bam}
		Rscript -e "rmarkdown::render('{params.ribowaltz_rmd}', params=list(bam='{params.linked_bam}', gtf='{params.gtf}', transcript_fasta='{params.transcript_fasta}', cds_coverage_out='{output.coverage}'), output_file='{output.html}')"
		"""

# Differentially Translated Genes - compare to DEGs